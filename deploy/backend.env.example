# Copiar como <VPS_PATH>/.env en el VPS (ej. ~/services/epico-prod/.env). No subir el archivo real al repositorio.
# Para dev: COMPOSE_PROJECT_NAME=epico-backend-dev, BACKEND_TAG=develop y otro BACKEND_PORT (ej. 5158).
COMPOSE_PROJECT_NAME=epico-backend-prod

POSTGRES_DB=epico_erp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR_POR_UNA_CLAVE_LARGA_Y_ALEATORIA

BACKEND_IMAGE=ghcr.io/epyco-software/epico-erp-backend
BACKEND_TAG=latest
BACKEND_BIND_IP=127.0.0.1
BACKEND_PORT=5157

FRONTEND_ORIGIN=https://erp.ejemplo.com

# Llave de los JWT (32+ caracteres aleatorios). Sin ella la API no arranca.
JWT_KEY=CAMBIAR_POR_32_O_MAS_CARACTERES_ALEATORIOS
# Contraseña de admin@epyco.cloud la primera vez que corre --migrate. Vacía = EpicoERP1. (cámbiala al entrar).
SEED_ROOT_PASSWORD=
# true = publica /scalar y /openapi/v1.json (útil en dev).
DOCS_ENABLED=false

# Cifra las contraseñas de los servidores de correo guardados en la base (32+ caracteres aleatorios).
# No la cambies después: las contraseñas guardadas ya no se podrían leer y habría que capturarlas otra vez.
CIFRADO_LLAVE=CAMBIAR_POR_32_O_MAS_CARACTERES_ALEATORIOS

# Servidor de correo global (reset de contraseña y organizaciones sin servidor propio). Vacío = no se envía nada.
# SMTP_SEGURIDAD: StartTls (587), Ssl (465) o Ninguna.
SMTP_HOST=
SMTP_PUERTO=587
SMTP_SEGURIDAD=StartTls
SMTP_USUARIO=
SMTP_PASSWORD=
SMTP_REMITENTE=EPICO <no-responder@epyco.cloud>
# Base de los enlaces de los correos (…/restablecer?token=…).
URL_ERP=https://erp.ejemplo.com
URL_PORTAL=https://portal.ejemplo.com
